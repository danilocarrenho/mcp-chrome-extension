{
  "manifest_version": 3,
  "name": "MCP Chrome Bridge",
  "version": "0.1.0",
  "description": "Lets an AI agent (Claude Code/Copilot CLI) control this browser through MCP.",
  "permissions": [
    "debugger",
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "cookies",
    "webRequest",
    "webNavigation",
    "alarms",
    "downloads",
    "browsingData"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "MCP Chrome Bridge"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
